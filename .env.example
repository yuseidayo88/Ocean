# Supabase（Phase 3）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role の鍵はここに置かない。行は全部 RLS で絞るので要らないし、
# Worker の env に置くと、漏れたとき全社のデータが出る

# モデル（Phase 7 から実際に使う）。**通り道は OpenRouter**
#   → docs/design/05-tech-and-cost.md「OpenRouter を入れる」
OPENROUTER_API_KEY=

# OpenRouter の一覧に出す名前（任意）
APP_URL=

# **鍵を入れるだけでいい。** どこでも表のモデル（lib/ai/catalog.ts の既定）で動く。
# 社員ごとのモデルと深さは、メンバー画面で社長が選ぶ（agent_prefs）。
#
# ただで回したいときだけ（**既定では使わない**。前は「本番以外は自動でこれ」だったので、
# 表を書き換えても本番以外には効かず、選んだモデルで動いていなかった）
# OPENROUTER_FREE_TEST=1
# 無料モデルは https://openrouter.ai/settings/privacy で
# 「Enable free endpoints that may train on inputs」を有効にしないと 404 になる
#
# 別のモデルを指名したいときだけ（指定すると常にこれが勝つ）
# OPENROUTER_MODEL_DEEP=
# OPENROUTER_MODEL_STANDARD=
# OPENROUTER_MODEL_FAST=

# 直につなぐときの逃げ道。lib/ai/tiers.ts の vendor を書き換えたときだけ要る
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 4 のダミーデータ表示モード。**ここには書かない**。
#   .env* に書くと OpenNext が既定値としてビルド成果物に焼き込み、本番にも付いていく。
#   ローカル: npm run dev:demo / npm run start:demo
#   Workers : wrangler の preview 環境（wrangler.jsonc の env.preview.vars）
# DEMO_MODE=1
